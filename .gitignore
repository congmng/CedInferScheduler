# Python
__pycache__/
*.py[cod]

# Logs
**/*.log
LLMServingSim/log/
LLMServingSim/astra-sim/log/

# Compiled ASTRA-Sim artifacts (keep the build scripts themselves)
LLMServingSim/astra-sim/build/astra_analytical/build/
LLMServingSim/astra-sim/build/astra_garnet/build/
LLMServingSim/astra-sim/build/astra_htsim/build/
LLMServingSim/astra-sim/build/astra_ns3/build/

# Simulation scratch outputs
LLMServingSim/outputs/*
!LLMServingSim/outputs/example_*.csv
LLMServingSim/astra-sim/inputs/runs/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store

# Local session transcript.  It contains the lab hosts' plaintext sudo
# passwords (pasted while debugging the cluster) and must never be pushed.
memory.md

# Raw datasets (CNN/DailyMail, Dolly, ShareGPT, tokenizer).  Large and
# re-downloadable; the workload generators read them from this path.
data/

# ShareGPT replays: one conversation in the source dataset quotes a Slack
# incoming-webhook URL, which GitHub's push protection blocks on every file
# that contains it.  Regenerate them locally with
#   python -m workloads.generators --dataset sharegpt ...   (see
# docs/实验数据集与对比基线说明.md) instead of committing the traces.
LLMServingSim/workloads/sharegpt-real-qwen3-8b-600-sps14.jsonl
LLMServingSim/workloads/sharegpt-real-qwen3-8b-600-sps14-slo500-50.jsonl
LLMServingSim/workloads/sharegpt-real-qwen3-8b-600-sps14-slo-tiered.jsonl
